{
  "expo": {
    "name": "target-app",
    "slug": "target-app",
    "scheme": "target-app",
    "version": "1.0.0",
    "android": {
      "package": "com.arthurfloro.target",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3D44CD"
      }
    },
    "ios": {
      "bundleIdentifier": "com.arthurfloro.target",
      "icon": "./assets/ios-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}